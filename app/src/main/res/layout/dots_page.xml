<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginHorizontal="32dp">


    <RelativeLayout
        android:id="@+id/three_dots_layout"
        android:layout_width="match_parent"
        android:layout_marginVertical="32dp"
        android:paddingBottom="28dp"
        android:layout_height="wrap_content"
        android:background="@drawable/order_history_background">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_marginHorizontal="24dp"
            android:layout_marginTop="24dp"
            android:layout_height="match_parent"
            android:background="@drawable/grey_background">

            <TextView
                android:background="@drawable/basket_card_border"
                android:id="@+id/forgot_password_3dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAlignment="center"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="14dp"
                android:paddingTop="4dp"
                android:paddingVertical="8dp"
                android:textSize="20sp"
                android:layout_marginHorizontal="24dp"
                android:textColor="#FFFFFF"
                android:text="@string/forgot_password"/>

            <TextView
                android:background="@drawable/basket_card_border"
                android:id="@+id/customer_support_3dots"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/forgot_password_3dots"
                android:textAlignment="center"
                android:layout_marginTop="14dp"
                android:paddingHorizontal="14dp"
                android:paddingTop="4dp"
                android:paddingVertical="8dp"
                android:textSize="20sp"
                android:layout_marginHorizontal="24dp"
                android:textColor="#FFFFFF"
                android:text="@string/support_placeholder"/>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>