<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/checkoutHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/checkout"
            android:textSize="36sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#000000"
            android:layout_marginBottom="24dp" />

        <TextView
            android:text="@string/email_placeholder"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/email_checkout"
            style="@style/InputStyle"
            android:inputType="textEmailAddress"
            android:hint="@string/enter_email"
            android:autofillHints="email" />

        <TextView
            android:text="@string/name_placeholder"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/name_checkout"
            style="@style/InputStyle"
            android:inputType="text"
            android:hint="@string/enter_name"
            android:autofillHints="name" />

        <TextView
            android:text="@string/address"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/address_checkout"
            style="@style/InputStyle"
            android:hint="@string/enter_address"
            android:inputType="textPostalAddress" />

        <TextView
            android:text="@string/postcode"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/postcode_checkout"
            style="@style/InputStyle"
            android:hint="@string/enter_postcode"
            android:inputType="textPostalAddress" />

        <TextView
            android:text="@string/town"
            style="@style/LabelStyle" />

        <EditText
            android:id="@+id/town_checkout"
            style="@style/InputStyle"
            android:hint="@string/enter_town"
            android:inputType="text" />

        <TextView
            android:text="@string/payment"
            style="@style/LabelStyle" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="@string/select_payment">

            <AutoCompleteTextView
                android:id="@+id/auto_complete_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none" />
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:id="@+id/priceText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/price"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="24dp" />

        <TextView
            android:id="@+id/itemQuantityHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/item_count"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#000000"
            android:layout_marginTop="8dp" />

        <Button
            android:id="@+id/payButton"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:text="@string/pay"
            android:textSize="24sp"
            android:textColor="@color/white"
            android:backgroundTint="#FF5555"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</ScrollView>


