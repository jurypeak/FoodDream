<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="24dp"
        android:paddingBottom="48dp">

        <TextView
            android:id="@+id/accountHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textAlignment="center"
            android:textColor="#000000"
            android:layout_marginBottom="24dp" />

        <TextView
            android:text="@string/email_placeholder"
            style="@style/CheckoutLabel" />

        <EditText
            android:id="@+id/email_account"
            style="@style/CheckoutInput"
            android:inputType="textEmailAddress"
            android:hint="@string/enter_email"
            android:autofillHints="email" />

        <TextView
            android:text="@string/name_placeholder"
            style="@style/CheckoutLabel" />

        <EditText
            android:id="@+id/name_account"
            style="@style/CheckoutInput"
            android:inputType="text"
            android:hint="@string/enter_name"
            android:autofillHints="name" />

        <TextView
            android:text="@string/password_placeholder"
            style="@style/CheckoutLabel" />

        <EditText
            android:id="@+id/password_account"
            style="@style/CheckoutInput"
            android:inputType="textPassword"
            android:hint="@string/enter_password"
            android:autofillHints="name" />

        <Button
            android:id="@+id/payButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/update"
            android:textSize="18sp"
            android:textColor="@color/white"
            android:backgroundTint="#FF5555"
            android:layout_marginTop="32dp" />

    </LinearLayout>

</ScrollView>

